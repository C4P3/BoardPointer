<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 32feet.NET. SYNC 中のボードを discover してHIDサービスを有効化するためだけに使う。
         WiiFitToVRC の reference/ から lib/ にコピーしたもの (MS-PL)。 -->
    <Reference Include="InTheHand.Net.Personal">
      <HintPath>..\..\lib\InTheHand.Net.Personal.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- 32feet.NET (.NET Framework 時代のアセンブリ) が内部で要求する。無いと
         BluetoothClient の生成時に FileNotFoundException になり、SYNC ペアリングだけが
         静かに失敗する。ボードを繋ぐ側は P/Invoke だけで動くので、気づきにくい。 -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

</Project>
